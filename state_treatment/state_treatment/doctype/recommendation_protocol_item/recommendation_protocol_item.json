{
  "doctype": "DocType",
  "name": "Recommendation Protocol Item",
  "module": "State Treatment",
  "custom": 0,
  "istable": 1,
  "fields": [
    {"fieldname": "item", "in_list_view": 1, "fieldtype": "Link", "label": "Item", "options": "Item", "reqd": 1, "description": "The treatment item from the protocol catalog. Required on every row."},
    {"fieldname": "item_name", "in_list_view": 1, "fieldtype": "Data", "label": "Item Name", "read_only": 1},
    {"fieldname": "treatment_type", "fieldtype": "Data", "label": "Treatment Type", "read_only": 1, "hidden": 1},
    {"fieldname": "medicine_name", "in_list_view": 1, "fieldtype": "Data", "label": "Medicine Name", "read_only": 1, "depends_on": "eval:doc.treatment_type == 'Medicine'"},
    {"fieldname": "number_of_doses", "in_list_view": 1, "fieldtype": "Int", "label": "Number of Doses", "read_only": 1, "depends_on": "eval:doc.treatment_type == 'Medicine'", "description": "Number of doses set by the protocol for this medicine. Filled automatically."},
    {"fieldname": "dose_interval_days", "fieldtype": "Float", "label": "Days Between Doses", "read_only": 1, "depends_on": "eval:doc.treatment_type == 'Medicine'", "description": "Days between two doses, set by the protocol. Filled automatically."},
    {"fieldname": "first_dose_date", "in_list_view": 1, "fieldtype": "Date", "label": "First Dose Date", "depends_on": "eval:doc.treatment_type == 'Medicine'", "description": "Date of the first dose. Required before final approval. The other doses are scheduled from this date using the protocol interval."},
    {"fieldname": "rate", "in_list_view": 1, "fieldtype": "Currency", "label": "Rate", "options": "currency", "read_only": 1, "description": "Price of this item in EGP from the State-funded price list. Filled automatically."},
    {"fieldname": "duration_days", "fieldtype": "Int", "label": "Duration (Days)", "read_only": 1},
    {"fieldname": "decision_sequence", "fieldtype": "Int", "label": "Decision Sequence", "read_only": 1},
    {"fieldname": "official_protocol_code", "fieldtype": "Data", "label": "Official Protocol Code", "read_only": 1},
    {"fieldname": "procedure_done", "in_list_view": 1, "fieldtype": "Check", "label": "Procedure Done", "depends_on": "eval:doc.treatment_type == 'Procedure'", "description": "Tick when the procedure has been performed. Only a Medical Reviewer can tick it, and it cannot be undone."},
    {"fieldname": "procedure_done_by", "fieldtype": "Link", "label": "Procedure Done By", "options": "User", "read_only": 1, "depends_on": "eval:doc.treatment_type == 'Procedure'"},
    {"fieldname": "procedure_done_on", "fieldtype": "Datetime", "label": "Procedure Done On", "read_only": 1, "depends_on": "eval:doc.treatment_type == 'Procedure'"}
  ],
  "permissions": []
}
