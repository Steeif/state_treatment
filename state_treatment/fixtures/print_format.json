{
 "doctype": "Print Format",
 "name": "Recommendation Official Form",
 "module": "State Treatment",
 "doc_type": "State Treatment Recommendation",
 "standard": "No",
 "print_format_type": "Jinja",
 "disabled": 0,
 "font": "Arial",
 "html": "<style>\n    .st-doc { font-family: Arial, sans-serif; font-size: 12px; color: #000; }\n    .st-doc h3 { text-align: center; margin: 4px 0; }\n    .st-codes { width: 100%; border-collapse: collapse; margin: 6px 0; }\n    .st-codes td { border: 1px solid #000; padding: 5px; width: 33%; text-align: center; font-weight: bold; }\n    .st-info { width: 100%; border-collapse: collapse; margin: 6px 0; }\n    .st-info td { border: 1px solid #000; padding: 4px 6px; }\n    .st-items { width: 100%; border-collapse: collapse; margin: 8px 0; }\n    .st-items th, .st-items td { border: 1px solid #000; padding: 4px 6px; font-size: 11px; }\n    .st-items th { background: #eee; }\n    .st-total td { font-weight: bold; background: #f5f5f5; }\n    .st-sign { width: 100%; margin-top: 50px; border-collapse: collapse; }\n    .st-sign td { width: 33%; text-align: center; padding-top: 45px; border-top: 1px dotted #000; font-weight: bold; }\n</style>\n\n<div dir=\"rtl\" class=\"st-doc\">\n    <h3>توصية علاج مواطن على نفقة الدولة</h3>\n\n    <table class=\"st-codes\">\n        <tr>\n            <td>كود المدخل: {{ doc.entry_code or \"&nbsp;\" }}</td>\n            <td>كود المراجع: {{ doc.reviewer_code or \"&nbsp;\" }}</td>\n            <td>كود الطبيب: {{ doc.doctor_code or \"&nbsp;\" }}</td>\n        </tr>\n    </table>\n\n    <table class=\"st-info\">\n        <tr>\n            <td><b>رقم التوصية:</b> {{ doc.recommendation_no or \"-\" }} / {{ doc.recommendation_year or \"-\" }}</td>\n            <td><b>الرقم القومي:</b> {{ doc.national_id or \"-\" }}</td>\n            <td><b>الحالة:</b> {{ doc.status }}</td>\n        </tr>\n        <tr>\n            <td colspan=\"2\"><b>المريض:</b> {{ doc.patient }}</td>\n            <td><b>الجهة المنفذة:</b> {{ doc.executing_facility or \"-\" }}</td>\n        </tr>\n        <tr>\n            <td><b>رقم قرار المجلس:</b> {{ doc.council_recommendation_no or \"-\" }}</td>\n            <td><b>تاريخ قرار المجلس:</b> {{ doc.get_formatted(\"council_recommendation_date\") or \"-\" }}</td>\n            <td><b>تاريخ الجلسة:</b> {{ doc.get_formatted(\"council_session_date\") or \"-\" }}</td>\n        </tr>\n    </table>\n\n    <table class=\"st-items\">\n        <thead>\n            <tr>\n                <th style=\"width:5%\">م</th>\n                <th>البند / الإجراء</th>\n                <th style=\"width:12%\">كود البروتوكول</th>\n                <th style=\"width:10%\">المدة (أيام)</th>\n                <th style=\"width:15%\">السعر</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.protocol_items %}\n            <tr>\n                <td>{{ loop.index }}</td>\n                <td>{{ row.item_name }}</td>\n                <td>{{ row.official_protocol_code or \"-\" }}</td>\n                <td>{{ row.duration_days or 0 }}</td>\n                <td>{{ row.get_formatted(\"rate\") }}</td>\n            </tr>\n            {% endfor %}\n            <tr class=\"st-total\">\n                <td colspan=\"4\">الإجمالي</td>\n                <td>{{ doc.get_formatted(\"total_amount\") }}</td>\n            </tr>\n        </tbody>\n    </table>\n\n    <table class=\"st-sign\">\n        <tr>\n            <td>{{ doc.admin_reviewer or \"المراجع الإداري\" }}</td>\n            <td>{{ doc.medical_reviewer or \"المراجع الطبي\" }}</td>\n            <td>{{ doc.general_manager or \"المدير العام\" }}</td>\n        </tr>\n    </table>\n</div>"
}